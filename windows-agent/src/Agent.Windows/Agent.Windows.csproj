<Project Sdk="Microsoft.NET.Sdk">

  <!-- App tray WPF untuk Windows 10/11. Bisa dibangun di macOS/Linux (EnableWindowsTargeting), tapi hanya jalan di Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF dan WinForms punya nama tipe yang sama (Application, Color, ...), jadi using ditulis eksplisit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CursorController</AssemblyName>
    <RootNamespace>CursorController.Agent.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Tema Fluent WPF masih ditandai eksperimental. DPI diatur lewat app.manifest karena app-nya WPF; WinForms
         hanya dipakai untuk ikon tray, jadi saran WFO0003 (DPI lewat API WinForms) tidak berlaku. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
